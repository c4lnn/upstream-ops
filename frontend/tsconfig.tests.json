{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "../.tmp/frontend-tests"
  },
  "include": [
    "lib/refresh-tracker.ts",
    "lib/sync-state.ts",
    "lib/sync-stream.ts",
    "tests/**/*.test.ts"
  ]
}
